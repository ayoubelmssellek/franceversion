# =============================================================================
# MeilleurIPTVFrance — Environment Variables (Vercel + local .env)
# =============================================================================

# WhatsApp for orders only (never shown on the website). Digits with country code.
NEXT_PUBLIC_WHATSAPP_INTL=xxxxxxxxxxx

# Site URL (SEO / canonical) — required in production for absolute URLs
NEXT_PUBLIC_SITE_URL=https://www.meilleuresiptvfrance.shop

# --- Hostinger SMTP (order emails) ---
# Outgoing: smtp.hostinger.com · Port 465 · SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
# From address (usually same as SMTP_USER)
SMTP_FROM="MeilleurIPTVFrance <your-email@yourdomain.com>"
# Where new-order alerts are sent (your Gmail or Hostinger inbox)
ORDER_NOTIFY_EMAIL=your-gmail@gmail.com

# --- Pricing ---
# Prices are HARD-CODED in src/lib/plan-pricing.ts (single source of truth).
# NEXT_PUBLIC_PRICE_* / NEXT_PUBLIC_COMPARE_* env vars are IGNORED by the code.
# To change a price, edit src/lib/plan-pricing.ts and redeploy.
