# SEO ops — local GSC / Semrush lists only (NOT used by the Next.js build).
# Still tracked: README.md, indexing-queue.md, image-keyword-*.md/json, audits.
# Never ignore: /src, /public, /scripts, package.json, next.config.*, sitemap, robots.
/seo-ops/*.csv
/seo-ops/*.tsv
/seo-ops/gsc-*
/seo-ops/semrush*
!/seo-ops/README.md

# Local SEO dumps at repo root only (leading / = root — does not touch src/)
/keyword injector/
/Semrush*
/semrush*
# Local scratch / OS
*.local
.DS_Store
Thumbs.db
